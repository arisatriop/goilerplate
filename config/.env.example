# Source for the goilerplate-secret Kubernetes Secret. The pods receive these through envFrom, and
# each one overrides its config.yaml key: dots become underscores (db.password -> DB_PASSWORD).
# The application never reads this file itself, and non-sensitive settings belong in config.yaml.
#
#   cp config/.env.example config/.env   # gitignored; fill it in
#   kubectl create secret generic goilerplate-secret -n <namespace> \
#     --from-env-file=./config/.env --dry-run=client -o yaml | kubectl apply -f -
#
# kubectl takes each value literally: no quotes, no spaces around "=", no comment after a value.
# Startup validation refuses any <PLACEHOLDER> left in a setting the configuration uses.
# Generate secrets rather than choosing them, with a different value for each.

# ---------- Required ----------

# PostgreSQL
DB_HOST=<DB_HOST>
DB_PORT=5432
DB_NAME=<DB_NAME>
DB_USERNAME=<DB_USERNAME>
DB_PASSWORD=<DB_PASSWORD>

# JWT signing secrets, at least 32 bytes: openssl rand -base64 48
JWT_ACCESS_SECRET=<JWT_ACCESS_SECRET>
JWT_REFRESH_SECRET=<JWT_REFRESH_SECRET>

# ---------- Optional: uncomment what your config.yaml enables ----------

# Redis (redis.enabled)
# REDIS_HOST=<REDIS_HOST>
# REDIS_PASSWORD=<REDIS_PASSWORD>

# Email verification codes (auth.email.enabled), at least 32 bytes: openssl rand -base64 48
# AUTH_OTP_SECRET=<AUTH_OTP_SECRET>

# Email: only the block for email.driver
# EMAIL_SMTP_USERNAME=<EMAIL_SMTP_USERNAME>
# EMAIL_SMTP_PASSWORD=<EMAIL_SMTP_PASSWORD>
# EMAIL_RESEND_API_KEY=<EMAIL_RESEND_API_KEY>
# Leave both out to use the IAM role
# EMAIL_SES_ACCESS_KEY_ID=<EMAIL_SES_ACCESS_KEY_ID>
# EMAIL_SES_SECRET_ACCESS_KEY=<EMAIL_SES_SECRET_ACCESS_KEY>

# File storage: only the block for filesystem.driver
# Leave both out to use the IAM role
# FILESYSTEM_S3_ACCESS_KEY_ID=<FILESYSTEM_S3_ACCESS_KEY_ID>
# FILESYSTEM_S3_SECRET_ACCESS_KEY=<FILESYSTEM_S3_SECRET_ACCESS_KEY>
# FILESYSTEM_DRIVE_CLIENT_ID=<FILESYSTEM_DRIVE_CLIENT_ID>
# FILESYSTEM_DRIVE_CLIENT_SECRET=<FILESYSTEM_DRIVE_CLIENT_SECRET>
# FILESYSTEM_DRIVE_REFRESH_TOKEN=<FILESYSTEM_DRIVE_REFRESH_TOKEN>

# /internal routes (internal_auth.mode=shared_secret), at least 32 bytes: openssl rand -base64 48
# INTERNAL_AUTH_SECRET=<INTERNAL_AUTH_SECRET>

# gRPC (grpc.auth.mode=shared_secret), at least 32 bytes: openssl rand -base64 48
# GRPC_AUTH_SECRET=<GRPC_AUTH_SECRET>

# AES-256-GCM key for pkg/crypto: openssl rand -base64 32
# CRYPTO_ENCRYPTION_KEY=<CRYPTO_ENCRYPTION_KEY>

# Partner API keys: API_KEY_<NAME>
# API_KEY_PARTNER1=<API_KEY_PARTNER1>

# External HTTP services: SERVICE_<NAME>_API_KEY
# SERVICE_PAYMENT_GATEWAY_API_KEY=<SERVICE_PAYMENT_GATEWAY_API_KEY>
