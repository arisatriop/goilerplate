# This variable is for MCP connectivity only, it should not be used for any other purpose.

# DATABASE
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=secret

# REDIS
REDIS_HOST=localhost:6379
REDIS_PASSWORD=secret
REDIS_DB=0

# JWT — names must match the config path with dots replaced by underscores
JWT_KEY_ID=v1
JWT_ACCESS_SECRET=your-access-token-super-secret-key
JWT_REFRESH_SECRET=your-refresh-token-super-secret-key

# CRYPTO
CRYPTO_ENCRYPTION_KEY=your-32-byte-encryption-key-here

# API KEYS (Internal)
API_KEY_DEFAULT=default-secret
API_KEY_PARTNER1=partner1-secret

# Github
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_token_here

# Jira
JIRA_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token_here
